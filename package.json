{
  "name": "intergrow-presentations",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "pnpm validate:content && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "test": "vitest run",
    "verify": "pnpm check && pnpm test && pnpm build"
  },
  "dependencies": {
    "astro": "7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "^24.19.2",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
